VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Paystack API Keys (Nigerian payment gateway - NGN recurring subscriptions)
PAYSTACK_SECRET_KEY=sk_test_xxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Optional server-side Firebase service account (base64 or JSON string, or GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server Port (Cloud Run injects PORT dynamically, defaults to 3000)
PORT=3000